{% extends "proverbs/layout.njk" %}

{% block content %}
  <section class="login-card">
    <h2>Log In to Admin</h2>
    
    <form method="POST" action="/login">
      <div class="form-grid">
        <div class="filter-group">
          <label for="username-input">Username or Email</label>
          <input id="username-input" name="username" type="text" placeholder="Enter username or email" required />
        </div>

        <div class="filter-group">
          <label for="password-input">Password</label>
          <input id="password-input" name="password" type="password" placeholder="Enter password" required />
        </div>

        {% if error %}
          <div class="alert error">
            {{ error }}
          </div>
        {% endif %}

        <button type="submit" class="btn-primary" style="margin-top: 1rem; width: 100%;">
          Log In
        </button>
      </div>
    </form>
  </section>
{% endblock %}
