{% extends "proverbs/layout.njk" %}

{% block content %}
  <section>
    <div class="proverbs-section-header">
      <h2>Admin Control Panel</h2>
      <a class="btn-primary" href="/admin/new">
        <svg style="width: 18px; height: 18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        New Proverb
      </a>
    </div>

    {% if proverbs.length %}
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title & Excerpt</th>
              <th>Author</th>
              <th>Category</th>
              <th>Language</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for proverb in proverbs %}
              <tr>
                <td>
                  <div class="admin-table-title">{{ proverb.title }}</div>
                  <div class="admin-table-excerpt">{{ proverb.content }}</div>
                </td>
                <td>{{ proverb.author }}</td>
                <td>{{ proverb.category }}</td>
                <td><span class="proverb-card-lang">{{ proverb.lang }}</span></td>
                <td style="text-align: right;">
                  <div class="admin-actions" style="justify-content: flex-end;">
                    <a href="/admin/{{ proverb._id }}/edit" class="btn-ghost" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 6px;">Edit</a>
                    <form method="POST" action="/admin/{{ proverb._id }}/delete" onsubmit="return confirm('Are you sure you want to delete this proverb?');">
                      <button type="submit" class="btn-danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {# Pagination Controls #}
      {% if pagination.pages > 1 %}
        <div class="pagination">
          {% set prevPage = pagination.page - 1 %}
          <a href="/admin?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ prevPage }}" 
             class="pagination-item {% if pagination.page == 1 %}disabled{% endif %}"
             aria-label="Previous Page">
            &laquo;
          </a>

          {% for i in range(1, pagination.pages + 1) %}
            <a href="/admin?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ i }}" 
               class="pagination-item {% if pagination.page == i %}active{% endif %}">
              {{ i }}
            </a>
          {% endfor %}

          {% set nextPage = pagination.page + 1 %}
          <a href="/admin?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ nextPage }}" 
             class="pagination-item {% if pagination.page == pagination.pages %}disabled{% endif %}"
             aria-label="Next Page">
            &raquo;
          </a>
        </div>
      {% endif %}
    {% else %}
      <div style="text-align: center; padding: 4rem 2rem; background: var(--bg-card); border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1.5rem;">There are no proverbs registered in the database.</p>
        <a href="/admin/new" class="btn-primary">Add Your First Proverb</a>
      </div>
    {% endif %}
  </section>
{% endblock %}
