{% extends "proverbs/layout.njk" %}

{% block content %}
  {# Hero Section: Random Quote #}
  {% if randomProverb %}
    <section class="hero-quote">
      <div class="hero-quote-header">
        <span class="hero-quote-title">Random Inspiration</span>
        <button id="refresh-quote-btn" class="btn-refresh" title="Get another random quote">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
        </button>
      </div>
      <blockquote class="hero-quote-content" id="quote-content" style="transition: opacity 0.3s ease;">{{ randomProverb.content }}</blockquote>
      <div class="hero-quote-author" id="quote-author" style="transition: opacity 0.3s ease;">{{ randomProverb.author }}</div>
    </section>
  {% endif %}

  {# Search & Filters Panel #}
  <section class="filters-panel">
    <h3>Search and Filters</h3>
    <form method="GET" action="/">
      <div class="filters-grid">
        <div class="filter-group" style="grid-column: span 2;">
          <label for="search-input">Keyword Search</label>
          <input type="text" id="search-input" name="q" value="{{ query.q or '' }}" placeholder="Search proverbs, tags, categories..." />
        </div>

        <div class="filter-group">
          <label for="lang-select">Language</label>
          <select id="lang-select" name="lang">
            <option value="">All Languages</option>
            {% for lang in filterOptions.languages %}
              <option value="{{ lang }}" {% if query.lang == lang %}selected{% endif %}>
                {% if lang == 'eng' %}English{% elif lang == 'swe' %}Swedish{% elif lang == 'fin' %}Finnish{% else %}{{ lang }}{% endif %}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="filter-group">
          <label for="author-select">Author</label>
          <select id="author-select" name="author">
            <option value="">All Authors</option>
            {% for author in filterOptions.authors %}
              <option value="{{ author }}" {% if query.author == author %}selected{% endif %}>{{ author }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="filter-group">
          <label for="category-select">Category</label>
          <select id="category-select" name="category">
            <option value="">All Categories</option>
            {% for category in filterOptions.categories %}
              <option value="{{ category }}" {% if query.category == category %}selected{% endif %}>{{ category }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="filter-group">
          <label for="tag-select">Tag</label>
          <select id="tag-select" name="tag">
            <option value="">All Tags</option>
            {% for tag in filterOptions.tags %}
              <option value="{{ tag }}" {% if query.tag == tag %}selected{% endif %}>{{ tag }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="filters-actions">
        <a href="/" class="btn-ghost">Clear Filters</a>
        <button type="submit" class="btn-primary">Apply Filters</button>
      </div>
    </form>
  </section>

  {# Proverbs List #}
  <section>
    <div class="proverbs-section-header">
      <h2>Browse Proverbs</h2>
      <span style="font-size: 0.9rem; color: var(--text-muted);">Found <strong>{{ pagination.total }}</strong> proverbs</span>
    </div>

    {% if proverbs.length %}
      <ul class="proverb-list">
        {% for proverb in proverbs %}
          <li class="proverb-card">
            <div class="proverb-card-header">
              <span class="proverb-card-title">{{ proverb.title }}</span>
              <span class="proverb-card-lang">{{ proverb.lang }}</span>
            </div>
            <p class="proverb-card-content">{{ proverb.content }}</p>
            {% if proverb.description %}
              <p class="proverb-card-description">{{ proverb.description }}</p>
            {% endif %}
            <div class="proverb-card-footer">
              <div class="proverb-meta">
                <span class="proverb-meta-item">By <strong>{{ proverb.author }}</strong></span>
                <span class="proverb-meta-item">In <strong>{{ proverb.category }}</strong></span>
              </div>
              {% if proverb.tags.length %}
                <div class="proverb-tags">
                  {% for tag in proverb.tags %}
                    <a href="/?tag={{ tag }}" class="tag-badge">{{ tag }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>

      {# Pagination Controls #}
      {% if pagination.pages > 1 %}
        <div class="pagination">
          {# Previous page link #}
          {% set prevPage = pagination.page - 1 %}
          <a href="/?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ prevPage }}" 
             class="pagination-item {% if pagination.page == 1 %}disabled{% endif %}"
             aria-label="Previous Page">
            &laquo;
          </a>

          {# Page numbers #}
          {% for i in range(1, pagination.pages + 1) %}
            <a href="/?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ i }}" 
               class="pagination-item {% if pagination.page == i %}active{% endif %}">
              {{ i }}
            </a>
          {% endfor %}

          {# Next page link #}
          {% set nextPage = pagination.page + 1 %}
          <a href="/?{% for k, v in query %}{% if k != 'page' %}{{ k }}={{ v }}&{% endif %}{% endfor %}page={{ nextPage }}" 
             class="pagination-item {% if pagination.page == pagination.pages %}disabled{% endif %}"
             aria-label="Next Page">
            &raquo;
          </a>
        </div>
      {% endif %}
    {% else %}
      <div style="text-align: center; padding: 3rem; background: var(--bg-card); border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1rem;">No proverbs found matching your search filters.</p>
        <a href="/" class="btn-primary">View All Proverbs</a>
      </div>
    {% endif %}
  </section>

  {# Client-side Refresh Script for Random Quote #}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const refreshBtn = document.getElementById('refresh-quote-btn');
      const quoteContent = document.getElementById('quote-content');
      const quoteAuthor = document.getElementById('quote-author');

      if (refreshBtn && quoteContent && quoteAuthor) {
        refreshBtn.addEventListener('click', async () => {
          refreshBtn.classList.add('spinning');
          try {
            const res = await fetch('/api/random');
            const data = await res.json();
            if (data.success && data.proverb) {
              // Fade out quote elements
              quoteContent.style.opacity = '0';
              quoteAuthor.style.opacity = '0';
              
              // Wait for fade transition, then replace text and fade back in
              setTimeout(() => {
                quoteContent.textContent = data.proverb.content;
                quoteAuthor.textContent = data.proverb.author || 'Unknown';
                quoteContent.style.opacity = '1';
                quoteAuthor.style.opacity = '1';
              }, 300);
            }
          } catch (err) {
            console.error('Failed to fetch random proverb:', err);
          } finally {
            // Stop spinning after animation finishes
            setTimeout(() => {
              refreshBtn.classList.remove('spinning');
            }, 800);
          }
        });
      }
    });
  </script>
{% endblock %}
