{
  "name": "proverbs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @proverbs/api",
    "dev:web": "npm run dev -w @proverbs/web",
    "start": "npm run start -w @proverbs/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^3.2.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "14.0.0"
  }
}
