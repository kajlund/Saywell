# Copy to apps/.env for the existing startup loader, or inject process variables.
# Use a development database; preserve the existing production database separately.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/proverbs
# Production: set NODE_ENV=production and the actual browser origin.
WEB_ORIGIN=http://localhost:5173
